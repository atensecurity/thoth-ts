{
  "name": "@atensec/thoth",
  "version": "0.6.1",
  "type": "module",
  "author": "Aten Engineering <engineering@atensecurity.com>",
  "description": "AI agent governance SDK by Aten Security",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/integrations/anthropic.d.ts",
      "import": "./dist/integrations/anthropic.js"
    },
    "./openai": {
      "types": "./dist/integrations/openai.d.ts",
      "import": "./dist/integrations/openai.js"
    },
    "./ai-sdk": {
      "types": "./dist/integrations/ai-sdk.d.ts",
      "import": "./dist/integrations/ai-sdk.js"
    },
    "./mcp": {
      "types": "./dist/integrations/mcp.d.ts",
      "import": "./dist/integrations/mcp.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/integrations/claude-agent-sdk.d.ts",
      "import": "./dist/integrations/claude-agent-sdk.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRIVACY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run src",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.15.3",
    "ai": "7.0.159",
    "typescript": "5.8.3",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "homepage": "https://atensecurity.com/thoth",
  "repository": {
    "type": "git",
    "url": "https://github.com/atensecurity/thoth-ts.git"
  },
  "keywords": [
    "ai",
    "governance",
    "security",
    "langchain",
    "agents",
    "thoth"
  ]
}
